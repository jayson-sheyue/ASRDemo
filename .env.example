# ADC 鉴权。先执行：
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#   gcloud services enable speech.googleapis.com --project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=
# Chirp 3 官方区域是 us / eu；Chirp 2 是 us-central1。
GOOGLE_CLOUD_LOCATION=us
# 本机端口。Cloud Run 使用平台注入的 PORT。
DEMO_PORT=8002
# 可选：自定义域名 Host（逗号分隔）。Cloud Run 会自动允许 *.run.app。
# ALLOWED_HOSTS=demo.example.com
